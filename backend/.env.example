PORT=5000

# Primary (use Atlas URI in production — see MONGODB_SETUP.md)
MONGODB_URI=mongodb://127.0.0.1:27017/memorynest

# Alias (optional — MONGODB_URI takes priority)
# MONGO_URI=mongodb://127.0.0.1:27017/memorynest
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/memorynest
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email (forgot password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MemoryNest <noreply@memorynest.com>

# Admin seed — only account (registration disabled)
ADMIN_EMAIL=alisaniya026@gmail.com
ADMIN_PASSWORD=your_secure_admin_password
